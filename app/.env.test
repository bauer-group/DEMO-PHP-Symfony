# Test environment
# Uses a file-based SQLite database for fast tests without MySQL

APP_ENV=test
APP_SECRET=test-secret-not-for-production

# Kernel booted by WebTestCase / KernelTestCase
KERNEL_CLASS='App\Kernel'

# SQLite file under var/ (no MySQL dependency). Not :memory: - every
# kernel boot opens a new connection, so an in-memory schema created in
# setUp() would be gone by the time the test client handles a request.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Disable Symfony deprecations helper noise
SYMFONY_DEPRECATIONS_HELPER=disabled
